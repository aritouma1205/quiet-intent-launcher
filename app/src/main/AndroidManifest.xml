<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 任意連携のための権限（設計8・13）。INTERNETはOpen-Meteoへの
         手動地域天気のみ。READ_CALENDARはユーザーが予定表示を有効化した
         時点でだけランタイム要求する。CAMERAはTOOLSのライトを初めて
         使う時点でだけランタイム要求する（設計13）。位置情報権限は
         要求しない。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ライトは任意機能。フラッシュ非搭載端末でもインストール・動作は
         そのままにし、行だけ「ライトなし」と表示する（設計7）。 -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 個人プロファイル内の起動可能なアプリだけを見るための限定した可視性宣言。
         QUERY_ALL_PACKAGES は要求しない（設計13章）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- HTTPSリンクの起動可否を確認するための可視性宣言（設計6・13）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- 「共有先を選ぶ」の受け手を確認するための可視性宣言（設計9.2）。 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- 予定をカレンダーアプリで開く受け手の確認（設計8.1）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
        <!-- TOOLSのタイマー一覧を開く受け手の確認（設計7）。 -->
        <intent>
            <action android:name="android.intent.action.SHOW_TIMERS" />
        </intent>
    </queries>

    <application
        android:name=".QuietLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuietIntentLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 任意のシステム操作サービス（設計13）。BIND_ACCESSIBILITY_SERVICE
             でOSのみがバインドでき、サービス設定はイベント取得・画面内容・
             ジェスチャー代行を一切要求しない。外部アプリや任意Intentからは
             呼び出せない。 -->
        <service
            android:name=".system.QuietSystemService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quiet_system_service" />
        </service>
    </application>
</manifest>
